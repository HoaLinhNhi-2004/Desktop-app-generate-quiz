{
  "name": "generate-quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AI-powered desktop quiz generator — create quizzes from PDF, DOCX, images, YouTube videos, or plain text using Google Gemini. Supports multiple question types (multiple-choice, true/false, fill-in-the-blank), quiz export to DOCX & Kahoot, performance analytics with charts, dark/light theme, and Vietnamese/English localization.",
  "author": "HoangLong",
  "keywords": [
    "quiz-generator",
    "ai-quiz",
    "gemini-api",
    "electron",
    "react",
    "typescript",
    "pdf-to-quiz",
    "docx-to-quiz",
    "youtube-to-quiz",
    "image-to-quiz",
    "multiple-choice",
    "true-false",
    "fill-in-the-blank",
    "kahoot-export",
    "quiz-analytics",
    "score-tracking",
    "heatmap",
    "i18n",
    "dark-mode",
    "desktop-app"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HoangLong08/Desktop-app-generate-quiz.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run transpile:electron && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run transpile:electron && npm run build && electron-builder --linux --x64",
    "build:desktop:win": "powershell -ExecutionPolicy Bypass -File ../back-end/build_backend.ps1 && npm run dist:win"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/react-query": "^5.90.3",
    "@tanstack/react-query-devtools": "^5.90.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.0",
    "framer-motion": "^12.35.0",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "os-utils": "^0.0.14",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.8",
    "react-is": "^19.2.4",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.13",
    "@types/os-utils": "^0.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "cross-env": "^10.1.0",
    "electron": "^40.7.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "semantic-release": "^25.0.3",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
