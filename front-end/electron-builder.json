{
  "appId": "com.hoanglong.generate-quiz",
  "productName": "Generate Quiz",
  "files": ["dist-electron", "dist-react"],
  "extraResources": [
    {
      "from": "backend",
      "to": "backend",
      "filter": ["**/*", "!**/__pycache__/**", "!**/*.pdb", "!**/*.pyc", "!**/*.pyo"]
    },
    "dist-electron/preload.cjs",
    "src/assets/**"
  ],
  "compression": "maximum",
  "asar": true,
  "electronLanguages": ["en-US", "vi"],
  "removePackageScripts": true,
  "removePackageKeywords": true,
  "publish": {
    "provider": "github",
    "owner": "HoangLong08",
    "repo": "Desktop-app-generate-quiz"
  },
  "mac": { "target": "zip", "icon": "src/assets/trayIcon.png" },
  "linux": { "target": "zip", "category": "Utility", "icon": "src/assets/trayIcon.png" },
  "win": { "target": "zip", "icon": "src/assets/trayIcon.png" }
}
