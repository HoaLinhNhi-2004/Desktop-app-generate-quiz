# Same gates as .github/workflows/ci.yml, run before anything leaves the machine.
# CI only reports after the push, so this is the only place a red build can be
# stopped. Takes ~2 min; `git push --no-verify` skips it when you mean to.
set -e

cd front-end

# Catches the exact failure CI hits first: package.json changed without its lock
# file. --dry-run validates the tree without touching node_modules.
echo "[pre-push 1/4] package-lock.json in sync"
npm ci --dry-run >/dev/null

echo "[pre-push 2/4] ESLint"
npm run lint

# `npm run build` is `tsc -b && vite build`, so it covers CI's type-check step.
echo "[pre-push 3/4] TypeScript + Vite build"
npm run build

echo "[pre-push 4/4] Electron transpile"
npm run transpile:electron

echo "pre-push: all CI gates passed"
