# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Google Gemini API keys are managed via the UI (Settings > API Keys).
# Get keys at: https://aistudio.google.com/apikey

# OAuth apps for the Google Drive / Notion material sources.
#
# You normally do NOT set these here: this project is open source, so each user
# registers their own OAuth app and enters it in the UI
# (Settings > Nguồn tài liệu bên ngoài), which verifies it before saving and
# stores the secrets encrypted. The variables below only exist as an override
# for a self-hosted or CI setup that prefers injecting them at boot; a stored
# credential always wins over them.
#
# Change this only if the backend does not listen on 127.0.0.1:5000. The
# redirect URI registered with each provider must match it exactly.
OAUTH_REDIRECT_BASE=http://127.0.0.1:5000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Browser API key with the Picker API enabled. GOOGLE_APP_ID is the project
# number; when blank it is derived from the client ID, which starts with it.
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
