# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Google Gemini API keys are managed via the UI (Settings > API Keys).
# Get keys at: https://aistudio.google.com/apikey

# OAuth apps for the Google Drive / Notion material sources.
# Leave blank to hide those sources in the UI. Register the redirect URI below
# verbatim with each provider — a mismatch is rejected before the consent screen.
#   Google  -> http://127.0.0.1:5000/api/integrations/google/callback
#             OAuth client type "Desktop app", scope drive.file (no verification needed)
#   Notion  -> http://127.0.0.1:5000/api/integrations/notion/callback
#             Public integration, https://www.notion.so/my-integrations
OAUTH_REDIRECT_BASE=http://127.0.0.1:5000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Browser API key with the Picker API enabled, plus the project number (appId).
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
